<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.demo</groupId>
    <artifactId>java-vuln-demos</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <!-- 固定 surefire 为 3.2.5：JDK 21 兼容。Spring Boot 2.7.18 默认继承 2.22.2，在 JDK 17+ 上会 IllegalAccessError -->
        <surefire.version>3.2.5</surefire.version>
        <!-- 统一 log4j2 家族版本为 2.14.1（Log4Shell 影响版本）。
             Spring Boot 2.7.18 默认管理到 2.17.2，不覆盖会出现 core 2.14.1 + api 2.17.2 混搭 -->
        <log4j2.version>2.14.1</log4j2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- 关键：排除 log4j-to-slf4j 桥接包。
                     它若存在，log4j2 API 的日志会被转发给 logback 输出，
                     log4j-core 的 MessagePatternConverter（${jndi:} 解析，即 Log4Shell）
                     根本不会执行，漏洞 8 将无法触发 -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
        SCA 靶场依赖：以下是历史上著名的含严重漏洞的旧版本
        它们的保留是为了让 SCA 类规则能"抓到"，并非真实业务依赖

        注：log4j 已由 1.2.17 换成 log4j-core 2.14.1（CVE-2021-44228 Log4Shell 影响版本），
        因为 ${jndi:...} Lookup 是 Log4j 2.x 的 MessagePatternConverter 特性，
        1.x 根本没有 Lookup 机制，用 1.2.17 的话漏洞 8 无法真实触发。
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>1.2.24</version>
        </dependency>
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>java-vuln-demos</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>